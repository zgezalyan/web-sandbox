FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api apps/api
COPY apps/web/package.json apps/web/package.json
COPY packages/shared packages/shared
RUN npm ci
RUN npm run build -w @web-sandbox/shared && npm run build -w @web-sandbox/api \
  && test -f packages/shared/dist/index.js \
  && mkdir -p /opt/shared-lib \
  && cp packages/shared/dist/*.js /opt/shared-lib/ \
  && printf '%s\n' '{"name":"@web-sandbox/shared","version":"1.0.0","type":"module","main":"./index.js","exports":"./index.js"}' > /opt/shared-lib/package.json \
  && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
RUN rm -rf node_modules/@web-sandbox/shared && mkdir -p node_modules/@web-sandbox
COPY --from=build /opt/shared-lib /app/node_modules/@web-sandbox/shared

RUN mkdir -p /app/data
WORKDIR /app/apps/api
EXPOSE 3001
CMD ["node", "--experimental-sqlite", "dist/index.js"]
